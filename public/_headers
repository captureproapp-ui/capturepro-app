# Cache hashed assets forever (they have content-based filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Don't cache the index.html or any HTML files
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Don't cache the root
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
